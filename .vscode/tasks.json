{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Configure VoxelSpace (Release)",
			"command": "cmake",
			"args": [
				"-S", ".",
				"-B", "build",
				"-DCMAKE_BUILD_TYPE=Release",
				"-DVOXEL_USE_THREADED_RENDER=OFF",
				"-DVOXEL_USE_AVX2=ON",
				"-DVOXEL_USE_SDL_IMAGE=ON",
				"-DVOXEL_USE_OVERLAY=OFF"
			],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"type": "shell",
			"label": "Build VoxelSpace",
			"command": "cmake",
			"args": ["--build", "build", "--config", "Release", "-j"],
			"dependsOn": "Configure VoxelSpace (Release)",
			"presentation": {
				"echo": false,
				"reveal": "silent",
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "shell",
			"label": "Run VoxelSpace",
			"linux": {
				"command": "./build/bin/vs"
			},
			"windows": {
				"command": ".\\build\\bin\\vs.exe"
			},
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Build and Run VoxelSpace",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Build VoxelSpace",
				"Run VoxelSpace"
			],
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "Configure VoxelSpace (Threaded)",
			"command": "cmake",
			"args": [
				"-S", ".",
				"-B", "build-threaded",
				"-DCMAKE_BUILD_TYPE=Release",
				"-DVOXEL_USE_THREADED_RENDER=ON",
				"-DVOXEL_USE_AVX2=ON",
				"-DVOXEL_USE_SDL_IMAGE=ON",
				"-DVOXEL_USE_OVERLAY=OFF"
			],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"type": "shell",
			"label": "Build VoxelSpace (Threaded)",
			"command": "cmake",
			"args": ["--build", "build-threaded", "--config", "Release", "-j"],
			"dependsOn": "Configure VoxelSpace (Threaded)",
			"presentation": {
				"echo": false,
				"reveal": "silent",
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build"
		},
		{
			"type": "shell",
			"label": "Run VoxelSpace (Threaded)",
			"linux": {
				"command": "./build-threaded/bin/vs"
			},
			"windows": {
				"command": ".\\build-threaded\\bin\\vs.exe"
			},
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Build and Run VoxelSpace (Threaded)",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Build VoxelSpace (Threaded)",
				"Run VoxelSpace (Threaded)"
			],
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "Configure VoxelSpace (Profile)",
			"command": "cmake",
			"args": [
				"-S", ".",
				"-B", "build",
				"-DCMAKE_BUILD_TYPE=RelWithDebInfo",
				"-DCMAKE_C_FLAGS_RELWITHDEBINFO=-O2 -g -fno-omit-frame-pointer",
				"-DVOXEL_USE_THREADED_RENDER=OFF",
				"-DVOXEL_USE_AVX2=ON",
				"-DVOXEL_USE_SDL_IMAGE=ON",
				"-DVOXEL_USE_OVERLAY=OFF"
			],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"type": "shell",
			"label": "Build VoxelSpace (Profile)",
			"command": "cmake",
			"args": ["--build", "build", "--config", "RelWithDebInfo", "-j"],
			"dependsOn": "Configure VoxelSpace (Profile)",
			"presentation": {
				"echo": false,
				"reveal": "silent",
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build"
		},
		{
			"type": "shell",
			"label": "Profile VoxelSpace (Callgrind)",
			"linux": {
				"command": "mkdir -p build/profile && valgrind --tool=callgrind --cache-sim=yes --branch-sim=yes --dump-instr=yes --collect-jumps=yes --callgrind-out-file=build/profile/callgrind.out.%p ./build/bin/vs -benchmark 30"
			},
			"problemMatcher": [],
			"dependsOn": "Build VoxelSpace (Profile)",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": true
			}
		},
		{
			"type": "shell",
			"label": "Open Callgrind in KCachegrind",
			"linux": {
				"command": "OUT=$(ls -t build/profile/callgrind.out.* 2>/dev/null | head -1); if [ -z \"$OUT\" ]; then echo 'No callgrind.out found in build/profile. Run \"Profile VoxelSpace (Callgrind)\" first.'; exit 1; fi; echo \"Opening $OUT\"; kcachegrind \"$OUT\""
			},
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false
			}
		},
		{
			"label": "Profile and Open in KCachegrind",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Profile VoxelSpace (Callgrind)",
				"Open Callgrind in KCachegrind"
			],
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "Configure VoxelSpace (WASM)",
			"command": "emcmake",
			"args": [
				"cmake",
				"-S", ".",
				"-B", "build-wasm",
				"-DCMAKE_BUILD_TYPE=Release",
				"-DVOXEL_USE_THREADED_RENDER=OFF",
				"-DVOXEL_USE_AVX2=OFF",
				"-DVOXEL_USE_SDL_IMAGE=ON",
				"-DVOXEL_USE_OVERLAY=OFF"
			],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"type": "shell",
			"label": "Build VoxelSpace (WASM)",
			"command": "cmake",
			"args": ["--build", "build-wasm", "--config", "Release", "-j"],
			"dependsOn": "Configure VoxelSpace (WASM)",
			"problemMatcher": ["$gcc"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"echo": false,
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"group": "build"
		},
		{
			"type": "shell",
			"label": "Run VoxelSpace (WASM)",
			"command": "emrun",
			"args": [
				"--no-emrun-detect",
				"build-wasm/bin/vs.html"
			],
			"dependsOn": "Build VoxelSpace (WASM)",
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"echo": false,
				"reveal": "always",
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": true
			}
		}
	]
}

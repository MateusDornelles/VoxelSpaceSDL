{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Configure VoxelSpace (Release)",
			"command": "cmake",
			"args": [
				"-S", ".",
				"-B", "build",
				"-DCMAKE_BUILD_TYPE=Release",
				"-DVOXEL_USE_THREADED_RENDER=ON",
				"-DVOXEL_USE_AVX2=ON",
				"-DVOXEL_USE_SDL_IMAGE=OFF",
				"-DVOXEL_USE_OVERLAY=OFF"
			],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"type": "shell",
			"label": "Build VoxelSpace",
			"command": "cmake",
			"args": ["--build", "build", "--config", "Release", "-j"],
			"dependsOn": "Configure VoxelSpace (Release)",
			"presentation": {
				"echo": false,
				"reveal": "silent",
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "shell",
			"label": "Run VoxelSpace",
			"linux": {
				"command": "./build/bin/vs"
			},
			"windows": {
				"command": ".\\build\\bin\\vs.exe"
			},
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Build and Run VoxelSpace",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Build VoxelSpace",
				"Run VoxelSpace"
			],
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "Configure VoxelSpace (OpenGL 3.3)",
			"command": "cmake",
			"args": [
				"-S", ".",
				"-B", "build-gl",
				"-DCMAKE_BUILD_TYPE=Release",
				"-DVOXEL_USE_OVERLAY=OFF"
			],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"type": "shell",
			"label": "Build VoxelSpace (OpenGL 3.3)",
			"command": "cmake",
			"args": ["--build", "build-gl", "--config", "Release", "-j"],
			"dependsOn": "Configure VoxelSpace (OpenGL 3.3)",
			"problemMatcher": ["$gcc"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"echo": false,
				"reveal": "silent",
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			}
		},
		{
			"type": "shell",
			"label": "Run VoxelSpace (OpenGL 3.3)",
			"linux": {
				"command": "./build-gl/bin/vs"
			},
			"windows": {
				"command": ".\\build-gl\\bin\\vs.exe"
			},
			"args": ["-renderer", "opengl"],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Build and Run VoxelSpace (OpenGL 3.3)",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Build VoxelSpace (OpenGL 3.3)",
				"Run VoxelSpace (OpenGL 3.3)"
			],
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "Configure VoxelSpace (WASM)",
			"command": "emcmake",
			"args": [
				"cmake",
				"-S", ".",
				"-B", "build-wasm",
				"-DCMAKE_BUILD_TYPE=Release",
				"-DVOXEL_USE_THREADED_RENDER=OFF",
				"-DVOXEL_USE_AVX2=OFF",
				"-DVOXEL_USE_SDL_IMAGE=OFF",
				"-DVOXEL_USE_OVERLAY=OFF"
			],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"type": "shell",
			"label": "Build VoxelSpace (WASM)",
			"command": "cmake",
			"args": ["--build", "build-wasm", "--config", "Release", "-j"],
			"dependsOn": "Configure VoxelSpace (WASM)",
			"problemMatcher": ["$gcc"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"echo": false,
				"reveal": "always",
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"group": "build"
		},
		{
			"type": "shell",
			"label": "Run VoxelSpace (WASM)",
			"command": "emrun",
			"args": [
				"--no-emrun-detect",
				"build-wasm/bin/vs.html"
			],
			"dependsOn": "Build VoxelSpace (WASM)",
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"echo": false,
				"reveal": "always",
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": true
			}
		}
	]
}

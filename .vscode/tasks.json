{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Build VoxelSpace",
			"linux": {
				"command": "./build.sh",
				"args": ["dbg", "sdlimage","overlay", "threaded"],
				"detail": "compiler: gcc-like",
				"problemMatcher": [
					"$gcc"
				]
			},
			"windows": {
				"command": ".\\build.bat",
				"args": ["dbg", "sdlimage", "overlay", "threaded"],
				"detail": "compiler: cl.exe",
				"problemMatcher": [
					"$msCompile"
				]
			},
			"presentation": {
				"echo": false,
				"reveal": "silent",
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "shell",
			"label": "Configure CMake",
			"command": "cmake",
			"args": [
				"-S", ".", "-B", "build",
				"-DCMAKE_BUILD_TYPE=Release",
				"-DVOXEL_USE_THREADED_RENDER=OFF"
			],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"type": "shell",
			"label": "Build VoxelSpace (CMake)",
			"command": "cmake",
			"args": ["--build", "build", "--config", "Release", "-j"],
			"dependsOn": "Configure CMake",
			"problemMatcher": [
				"$gcc"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"type": "shell",
			"label": "Run VoxelSpace",
			"linux": {
				"command": "./out/vs"
			},
			"windows": {
				"command": ".\\out\\vs.exe"
			},
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Build and Run VoxelSpace",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Build VoxelSpace (CMake)",
				"Run VoxelSpace"
			],
			"problemMatcher": []
		}
	]
}
